# Suhum backend — copy to .env and adjust

DATABASE_MODE=sqlite
SQLITE_DB_PATH=./suhum.db

# MySQL (optional)
# DATABASE_MODE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=suhum

JWT_SECRET=change-suhum-jwt-secret-in-production
JWT_EXPIRE_MINUTES=480

HOST=0.0.0.0
PORT=8111

CORS_ORIGINS=http://localhost:9002,http://127.0.0.1:9002

FACILITY_NAME=Suhum Claims
FACILITY_CODE=

SUHUM_ADMIN_USERNAME=admin
SUHUM_ADMIN_PASSWORD=suhum123

# NHIA CCC (copy from main HMS .env if needed)
NHIA_INTEGRATION_ENABLED=true
NHIA_CCC_BASE_URL=https://otac.nhia.gov.gh
NHIA_USERNAME=
NHIA_PASSWORD=
NHIA_API_KEY=
NHIA_API_SECRET=
NHIA_DEFAULT_OTAC=

# Main HMS database URL for price list sync script
# MAIN_DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/hms_db
