# SQLite for local; MySQL on Hostinger
DATABASE_MODE=sqlite
SQLITE_DB_PATH=./data/license_portal_v2.db

# MySQL (Hostinger hPanel → Databases)
# DATABASE_MODE=mysql
# Use 127.0.0.1 not localhost — Node resolves localhost to IPv6 ::1 and Hostinger denies it.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=license_admin
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=hms_licenses_v2
# Hostinger: add 127.0.0.1 in Databases → Remote MySQL. Optional socket:
# MYSQL_SOCKET=/tmp/mysql.sock

# Must match LICENSE_ISSUER_SLUG on each HMS installation
ISSUER_SLUG=your-brand-slug

# Optional extra binding: same value as LICENSE_DISTRIBUTION_ID on HMS
DISTRIBUTION_ID=

# RSA private key used ONLY here — never ship to customers or put in public_html.
# Generate: openssl genrsa -out /home/USER/license_private.pem 3072
RSA_PRIVATE_KEY_FILE=./license_private.pem
# RSA_PRIVATE_KEY_PEM=

# HMS calls POST {LICENSE_VERIFY_URL}/verify/online with this header value
VERIFY_SHARED_SECRET=change-me-long-random

# Portal operator (seeded on first boot if no admin user exists)
PORTAL_ADMIN_EMAIL=license_admin
PORTAL_ADMIN_PASSWORD=change-this-password

PORTAL_JWT_SECRET=another-long-random-secret
PORTAL_JWT_EXPIRE_MINUTES=480

# Public URL of this app (no trailing slash). Used for Paystack callback.
PUBLIC_BASE_URL=http://127.0.0.1:9500

# Paystack (Ghana). Use test keys locally, live keys on Hostinger.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Invoice / receipt letterhead
COMPANY_NAME=Your Company Ltd
COMPANY_ADDRESS=Accra, Ghana
COMPANY_PHONE=+233 XX XXX XXXX
COMPANY_EMAIL=billing@example.com
COMPANY_TIN=

# Set true behind HTTPS on Hostinger
# COOKIE_SECURE=true

HOST=0.0.0.0
PORT=9500
