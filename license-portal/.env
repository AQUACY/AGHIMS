# Separate database from HMS — license rows never appear in the HMS database.
DATABASE_MODE=mysql
SQLITE_DB_PATH=./license_portal.db

# MySQL example (optional)
DATABASE_MODE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hms_licenses

# Must match LICENSE_ISSUER_SLUG on the HMS installation
# ISSUER_SLUG=KDG

# Optional extra binding: set the same value as LICENSE_DISTRIBUTION_ID on HMS
DISTRIBUTION_ID=

# RSA private key used ONLY here — never ship this to customers.
# Generate: openssl genrsa -out license_private.pem 3072
#           openssl rsa -in license_private.pem -pubout -out license_public.pem
# RSA_PRIVATE_KEY_FILE=./license_private.pem

# HMS calls POST {LICENSE_VERIFY_URL}/verify/online with this header value
# VERIFY_SHARED_SECRET=change-me-long-random

# Portal operator login (separate from HMS users)
# PORTAL_ADMIN_USERNAME=license_admin
# PORTAL_ADMIN_PASSWORD=change-this-password
# 
# PORTAL_JWT_SECRET=another-long-random-secret


HOST=0.0.0.0
PORT=9500

RSA_PRIVATE_KEY_FILE="C:/Users/Surface/Documents/license-secrets/license_private.pem"
ISSUER_SLUG="KDG"
VERIFY_SHARED_SECRET="NyK0hxbUbhlbtG8pQk-0e5frE8wUIozWqvhB7tzcDZg"
PORTAL_JWT_SECRET="462DQm1MZJBNNsV0BCoTE2AUYat9Or0O4xW84BXD3ZktNL5YCG0Or7rpJlZfiDVy"
