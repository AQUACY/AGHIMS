# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# Backend FastAPI base URL — include the /api suffix.
# Examples:
#   API_BASE_URL=http://localhost:8000/api
#   API_BASE_URL=http://10.10.16.40:8000/api
#   API_BASE_URL=https://app.aquacy.me/api

API_BASE_URL=http://localhost:8000/api
